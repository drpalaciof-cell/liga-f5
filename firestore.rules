rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{id} {
      allow read, write: if request.auth != null;
    }
    match /equipos/{id} {
      allow read, write: if request.auth != null;
    }
    match /partidos/{id} {
      allow read, write: if request.auth != null;
    }
    match /avisos/{id} {
      allow read, write: if request.auth != null;
    }
    match /config/{id} {
      allow read, write: if request.auth != null;
    }
    match /pushSubscriptions/{id} {
      allow read, write: if request.auth != null;
    }
    match /mensajes/{id} {
      allow read, write: if request.auth != null;
      match /replies/{replyId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
