rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }
    function isAdmin() {
      return autenticado() && request.auth.token.role == 'admin';
    }
    function isEquipoPropio(id) {
      return autenticado() && request.auth.token.role == 'equipo' && request.auth.token.equipoId == id;
    }
    // Campos que solo las acciones de admin pueden tocar (aprobar/rechazar
    // pago o seguro, habilitación tardía). Un equipo puede seguir editando su
    // propio documento (jugadores, escudo, contraseña, etc.) siempre que no
    // toque esto — con la excepción de pagoEstado/pagoSaldoEstado, que el
    // equipo SÍ necesita poder poner en 'pendiente' al subir un comprobante;
    // lo único que tiene prohibido es aprobarse o rechazarse a sí mismo.
    function noTocaCamposAdmin() {
      let tocados = request.resource.data.diff(resource.data).affectedKeys();
      let tocaProhibidos = tocados.hasAny([
        'pagoFechaRevision', 'pagoSaldoFechaRevision', 'seguroJugadoresDni', 'seguroHabilitadoManual'
      ]);
      let pagoOk = !tocados.hasAny(['pagoEstado']) || request.resource.data.pagoEstado == 'pendiente';
      let saldoOk = !tocados.hasAny(['pagoSaldoEstado']) || request.resource.data.pagoSaldoEstado == 'pendiente';
      return !tocaProhibidos && pagoOk && saldoOk;
    }

    // Solo la Cloud Function `login` (Admin SDK, bypassea las reglas) puede
    // leer o escribir acá. Antes cualquier visitante anónimo podía leer el
    // hash de contraseña de todos los admins.
    match /admins/{id} {
      allow read, write: if false;
    }

    match /equipos/{id} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update: if isAdmin() || (isEquipoPropio(id) && noTocaCamposAdmin());
      allow delete: if isAdmin();

      // Fotos de carnet, una por jugador, en su propio documento — así el tamaño de la
      // lista de buena fe nunca puede por sí solo empujar al documento del equipo contra
      // el límite de 1MB de Firestore.
      match /fotos/{dni} {
        allow read: if autenticado();
        allow write: if isAdmin() || isEquipoPropio(id);
      }
    }

    // Hash de contraseña de cada equipo, separado del documento público de
    // equipos/{id} (que cualquiera puede leer para listados/standings).
    // Nunca es legible por un cliente — solo la Cloud Function `login` (o
    // cambiarPasswordEquipo/resetPasswordEquipoServer) lo tocan con el
    // Admin SDK. El equipo puede crear el suyo propio al registrarse y
    // actualizarlo después de logueado; nadie puede leerlo nunca.
    match /credenciales/{id} {
      allow read: if false;
      allow create: if autenticado();
      allow update: if isAdmin() || isEquipoPropio(id);
      allow delete: if isAdmin();
    }

    // El planillero entra con sesión anónima (sin custom claim), así que a nivel de reglas
    // no hay forma de distinguir "el planillero de ESTE partido" de cualquier otra sesión
    // anónima — eso requeriría rehacer el login del planillero con claims propios, cambio
    // grande para tocar días antes de que arranque la temporada. Lo que sí se puede acotar
    // sin ese rediseño: ninguna sesión anónima puede tocar los campos de identidad del
    // fixture (contra qué equipo juega, en qué cancha, qué fecha) — solo el admin genera o
    // corrige eso. Antes cualquier autenticado (anónimo incluido) podía reescribir cualquier
    // campo de cualquier partido no cerrado, incluyendo estos.
    function soloCamposPlanilla() {
      let tocados = request.resource.data.diff(resource.data).affectedKeys();
      return !tocados.hasAny([
        'equipoLocalId', 'equipoVisitanteId', 'equipoLocalNombre', 'equipoVisitanteNombre',
        'division', 'zona', 'numeroFecha', 'cancha', 'horario'
      ]);
    }
    match /partidos/{id} {
      allow read: if autenticado();
      allow create: if autenticado();
      // Una vez cerrado el partido, la planilla queda tal cual — ni el
      // planillero ni un equipo pueden modificarla. Solo el admin puede
      // corregir un error después, desde "Editar resultado".
      allow update: if isAdmin() || (autenticado() && resource.data.get('estado','') != 'cerrado' && soloCamposPlanilla());
      allow delete: if isAdmin();
    }
    // Pagos semanales de arancel. Un equipo carga el suyo (estado 'pagado' al
    // crear, nunca puede ponerse 'aprobado' a sí mismo) y solo puede leer los
    // propios (filtrados por equipoId); el admin ve y gestiona todos, incluido
    // rechazar un comprobante mal cargado.
    match /aranceles/{id} {
      allow read: if isAdmin() || (autenticado() && request.auth.token.role == 'equipo' && resource.data.equipoId == request.auth.token.equipoId);
      allow create: if isAdmin() || (autenticado() && request.auth.token.role == 'equipo' && request.resource.data.equipoId == request.auth.token.equipoId && request.resource.data.estado == 'pagado');
      allow update, delete: if isAdmin();
    }
    match /avisos/{id} {
      allow read, write: if autenticado();
    }
    match /config/{id} {
      allow read: if autenticado();
      allow write: if isAdmin();
    }
    match /pushSubscriptions/{id} {
      allow read, write: if autenticado();
    }
    match /mensajes/{id} {
      allow read, write: if autenticado();
      match /replies/{replyId} {
        allow read, write: if autenticado();
      }
    }
    // Aviso rápido admin <-> planillero por cancha (1 doc por cancha, no es un chat con
    // historial) y botón de "llamar al organizador". Sin datos sensibles, cualquier
    // autenticado (incluida la sesión anónima del planillero) puede leer y escribir.
    match /avisosPlanilla/{cancha} {
      allow read, write: if autenticado();
    }
    // Marca puramente organizativa de "esta fecha ya terminó" — no bloquea
    // nada por sí sola, cualquier planillero o admin puede tocarla.
    match /fechasCerradas/{id} {
      allow read, write: if autenticado();
    }
  }
}
